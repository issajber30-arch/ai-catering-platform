# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Supabase — use the DEV project locally and on the Render dev service (render.yaml).
# Postgres connection string (Supabase → Project Settings → Database → Connection pooler).
DATABASE_URL=
# Local dev example: postgresql+psycopg://localhost/catering_dev
# Or, with no Postgres at all: sqlite:///./caterking_dev.db (local dev/tests only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the test suite (it DROPs and recreates the public schema, so never point at dev data).
TEST_DATABASE_URL=
DEFAULT_CURRENCY=ILS
STORAGE_BUCKET=dish-images

# Claude API key for the Phase 4 assistant (server-side only; never commit). Empty = assistant off.
ANTHROPIC_API_KEY=
BUSINESS_TIMEZONE=Asia/Jerusalem

# Twilio SMS/WhatsApp updates (server-side only; never commit). Empty = sending off.
# Needs SID + token and at least one sender number (E.164; the WhatsApp one without "whatsapp:").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
